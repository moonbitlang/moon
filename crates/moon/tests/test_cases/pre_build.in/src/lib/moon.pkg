rule(
  name: "generate_1",
  command: ":embed --text -i $input -o $output",
)
dev_build(
  rule: "generate_1",
  input: "a.txt",
  output: "a.mbt",
)

rule(
  name: "generate_2",
  command: ":embed --binary -i $input -o $output --name _b",
)
dev_build(
  rule: "generate_2",
  input: ["b.txt"],
  output: "b.mbt",
)

rule(
  name: "generate_3",
  command: ":embed -i $input -o $output --name _c",
)
dev_build(
  rule: "generate_3",
  input: "c.txt",
  output: "c.mbt",
)
