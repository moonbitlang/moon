moonc check ./lib/hello.mbt ./lib/hello.mbtp -o ./_build/wasm-gc/debug/check/lib/lib.mi -pkg username/prove_doctest/lib -pkg-type library -i '$MOON_HOME/lib/core/_build/wasm-gc/release/bundle/builtin/builtin.mi:moonbitlang/core/builtin' -i '$MOON_HOME/lib/core/_build/wasm-gc/release/bundle/prelude/prelude.mi:moonbitlang/core/prelude' -pkg-sources username/prove_doctest/lib:./lib -target wasm-gc -workspace-path . -all-pkgs ./_build/wasm-gc/debug/check/all_pkgs.json
mooninfo '-format=text' ./_build/wasm-gc/debug/check/lib/lib.mi '-o=./_build/wasm-gc/debug/check/lib/lib.mbti'
moonc check -doctest-only ./lib/hello.mbt -include-doctests -o ./_build/wasm-gc/debug/check/lib/lib.blackbox_test.mi -pkg username/prove_doctest/lib_blackbox_test -pkg-type library -i ./_build/wasm-gc/debug/check/lib/lib.mi:lib -i '$MOON_HOME/lib/core/_build/wasm-gc/release/bundle/builtin/builtin.mi:moonbitlang/core/builtin' -i '$MOON_HOME/lib/core/_build/wasm-gc/release/bundle/prelude/prelude.mi:moonbitlang/core/prelude' -pkg-sources username/prove_doctest/lib_blackbox_test:./lib -target wasm-gc -blackbox-test -workspace-path . -all-pkgs ./_build/wasm-gc/debug/check/all_pkgs.json
