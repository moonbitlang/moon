----
import { "moonbitlang/core/env" }
permission(env: { "from_host": ["VIRTUAL_CHAIN"] })
----
#unsafe_skip_stub_check
fn pid() -> Int = "moonbitlang/async" "env_util/getpid"
fn main raise {
  println(pid())
  println(@env.get_env_var("VIRTUAL_CHAIN").unwrap())
  let args = @env.args()
  assert_eq(args[2:], ["--help", "--target", "native", "--moonrun-artifact-handoff"])
  println(args[1])
}
