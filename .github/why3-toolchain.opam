# After installing the desired Why3 dependencies with CI's OCaml version,
# regenerate the cache's dependency lock with:
#   opam lock ./.github/why3-toolchain.opam
opam-version: "2.0"
synopsis: "Why3 dependencies for Moon's verification tests"
maintainer: "jichuruanjian@idea.edu.cn"
authors: "MoonBit contributors"
license: "Apache-2.0"
homepage: "https://github.com/moonbitlang/moon"
bug-reports: "https://github.com/moonbitlang/moon/issues"
depends: [
  "why3" {= "1.7.2"}
]
